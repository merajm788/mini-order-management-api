APP_NAME="Mini Order Management API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# DB_HOST=mysql / DB_PORT=3306 when running inside docker compose.
# DB_HOST=127.0.0.1 / DB_PORT=3307 when running artisan on the host.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=mini_order_management
DB_USERNAME=laravel
DB_PASSWORD=password
DB_ROOT_PASSWORD=password
DB_FORWARD_PORT=3307

PMA_PORT=8080

# --- Session / cache / queue --------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Orders are dispatched onto the "orders" queue; run: php artisan queue:work
QUEUE_CONNECTION=redis

# Product listings/details are cached in Redis (see ProductRepository).
CACHE_STORE=redis
CACHE_PREFIX=moms
PRODUCT_CACHE_TTL=600

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_FORWARD_PORT=6380

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_ORDERS=10

# --- Mail (Mailpit UI: http://localhost:8025) ---------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@mini-order-management.test"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
